+// Receive buffer of one connection: replies are parsed where recv put them;
+// only an incomplete tail is moved to the front.
+struct rx_buffer {
+    static constexpr std::size_t cap = 64 * 1024;
+    std::unique_ptr<char[]> data{new char[cap]};
+    std::size_t len = 0;
+    char* free_space() noexcept { return data.get() + len; }
+    std::size_t free_bytes() const noexcept { return cap - len; }
+    void consume(std::size_t n) noexcept {
+        if (n < len) std::memmove(data.get(), data.get() + n, len - n);
+        len -= n;
+    }
+};
