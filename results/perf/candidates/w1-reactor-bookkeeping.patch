+// ---------------------------------------------------------------- node pool
+
+namespace {
+constexpr std::size_t pool_classes = 4; // blocks of 64, 128, 192 and 256 bytes
+constexpr std::size_t pool_keep = 1024; // blocks kept per class and thread
+
+struct node_free_lists {
+    struct block {
+        block* next;
+    };
+    block* head[pool_classes] = {};
+    std::size_t count[pool_classes] = {};
+    bool alive = true;
+    ~node_free_lists() {
+        alive = false;
+        for (std::size_t c = 0; c < pool_classes; ++c)
+            for (block* b = std::exchange(head[c], nullptr); b;)
+                ::operator delete(static_cast<void*>(std::exchange(b, b->next)));
+    }
+};
+thread_local node_free_lists node_lists;
+
+std::size_t pool_class(std::size_t size) noexcept { return (size + 63) / 64 - 1; }
+} // namespace
+
+void* detail::node_pool::allocate(std::size_t size) {
+    const std::size_t c = pool_class(size);
+    if (c >= pool_classes) return ::operator new(size);
+    auto& l = node_lists;
+    if (auto* b = l.head[c]) {
+        l.head[c] = b->next;
+        --l.count[c];
+        return b;
+    }
+    return ::operator new((c + 1) * 64);
+}
+
+void detail::node_pool::release(void* p, std::size_t size) noexcept {
+    const std::size_t c = pool_class(size);
+    auto& l = node_lists;
+    if (c >= pool_classes || !l.alive || l.count[c] >= pool_keep) {
+        ::operator delete(p);
+        return;
+    }
+    auto* b = static_cast<node_free_lists::block*>(p);
+    b->next = l.head[c];
+    l.head[c] = b;
+    ++l.count[c];
+}
+
