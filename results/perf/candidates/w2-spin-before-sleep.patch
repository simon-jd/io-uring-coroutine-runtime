+bool reactor::spin_for_work() noexcept {
+    const auto deadline = std::chrono::steady_clock::now() + cfg_.spin_before_sleep;
+    const bool watch_taskrun = (setup_flags_ & IORING_SETUP_TASKRUN_FLAG) != 0;
+    for (unsigned i = 1;; ++i) {
+        if (io_uring_cq_ready(&ring_) > 0) return true;
+        if (watch_taskrun && (IO_URING_READ_ONCE(*ring_.sq.kflags) & IORING_SQ_TASKRUN)) return true;
+        if (cfg_.doorbell && rt_ && inbound_pending()) return true;
+        if ((i & 31) == 0 && std::chrono::steady_clock::now() >= deadline) return false;
+#if defined(__x86_64__) || defined(__i386__)
+        __builtin_ia32_pause();
+#endif
+    }
+}
