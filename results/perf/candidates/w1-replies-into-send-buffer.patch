+template <class Append>
+void plan::assemble_with(Append&& append) {
+    std::string combined; // only for replies summed or merged over several cores
+    for (const auto& e : entries_) {
+        if (e.how == combine::copy) {
+            append(part_reply(parts_[e.first]));
+            continue;
+        }
+        long long total = 0;
+        bool failed = false;
+        for (std::uint32_t i = 0; i < e.count && !failed; ++i) {
+            const auto r = part_reply(parts_[e.first + i]);
+            if (!r.empty() && r[0] == '-') {
+                append(r);
+                failed = true;
+            } else if (e.how == combine::sum) {
+                long long v = 0;
+                if (r.size() >= 3 && r[0] == ':' && parse_ll(r.substr(1, r.size() - 3), v)) total += v;
+            }
+        }
+        if (failed) continue;
+        combined.clear();
+        if (e.how == combine::sum) reply_int(combined, total);
+        else reply_simple(combined, "OK");
+        append(std::string_view(combined));
+    }
+}
