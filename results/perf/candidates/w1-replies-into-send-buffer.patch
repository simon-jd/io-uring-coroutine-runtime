+// Appends `piece` to the first `used` bytes of `buf`, growing it to the next
+// power of two when it does not fit.
+void put(owned_buffer& buf, std::size_t& used, std::string_view piece) {
+    if (buf.capacity() - used < piece.size()) {
+        auto bigger = owned_buffer::allocate(std::bit_ceil(used + piece.size()));
+        if (used) std::memcpy(bigger.storage().data(), buf.storage().data(), used);
+        buf = std::move(bigger);
+    }
+    if (!piece.empty()) std::memcpy(buf.storage().data() + used, piece.data(), piece.size());
+    used += piece.size();
+}
