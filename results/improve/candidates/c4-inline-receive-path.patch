+// Multishot results waiting to be consumed, in arrival order: a ring that
+// doubles when full and keeps its storage when the slot is reused.
+class result_queue {
+public:
+    bool empty() const noexcept { return count_ == 0; }
+    std::size_t size() const noexcept { return count_; }
+    void push_back(io_result r) {
+        if (count_ == cap_) grow();
+        buf_[(head_ + count_) & (cap_ - 1)] = r;
+        ++count_;
+    }
+    io_result pop_front() noexcept {
+        const io_result r = buf_[head_];
+        head_ = (head_ + 1) & (cap_ - 1);
+        --count_;
+        return r;
+    }
+    void clear() noexcept { head_ = count_ = 0; }
+    template <class Fn>
+    void for_each(Fn&& fn) const {
+        for (std::uint32_t i = 0; i < count_; ++i) fn(buf_[(head_ + i) & (cap_ - 1)]);
+    }
+
+private:
+    void grow() {
+        const std::uint32_t cap = cap_ ? cap_ * 2 : 8;
+        std::unique_ptr<io_result[]> bigger(new io_result[cap]);
+        for (std::uint32_t i = 0; i < count_; ++i) bigger[i] = buf_[(head_ + i) & (cap_ - 1)];
+        buf_ = std::move(bigger);
+        cap_ = cap;
+        head_ = 0;
+    }
+    std::unique_ptr<io_result[]> buf_;
+    std::uint32_t cap_ = 0; // 0 or a power of two
+    std::uint32_t head_ = 0;
+    std::uint32_t count_ = 0;
+};
